---
import { getCollection } from 'astro:content';
import ServiceCard from 'components/ServiceCard.astro';
import { subTitleService, titleService } from 'consts/pagesTitle';
import SeeMoreButton from 'components/ui/SeeMoreButton.astro';
import type { IconName } from 'consts/icons';

const servicesEntries = await getCollection('services');
const services = servicesEntries
  .map((entry) => ({
    order: entry.data.order,
    title: entry.data.title,
    description: entry.data.description,
    slug: entry.slug,
    iconName: entry.slug as IconName,
  }))
  .sort((a, b) => a.order - b.order);
---

<section
  id="services"
  class="relative flex w-full max-w-[1200px] -scroll-mt-10 flex-col items-center justify-center gap-20 px-2 py-40 md:scroll-mt-6"
>
  <header class="flex w-[90%] flex-col items-center justify-center gap-4 text-center md:w-[100%]">
    <h2 class="text-2xl font-bold text-secondary uppercase duration-300 sm:text-4xl md:text-5xl">
      {titleService}
    </h2>
    <h3 class="text-sm font-medium text-primary sm:text-lg md:text-3xl">{subTitleService}</h3>
  </header>

  <div
    id="services-container"
    class="relative flex w-full flex-col flex-wrap items-center justify-center gap-4 md:flex-row"
  >
    {
      services.map((service) => (
        <ServiceCard
          index={service.order}
          title={service.title}
          description={service.description}
          iconName={service.iconName}
          slug={service.slug}
        />
      ))
    }
  </div>

  <SeeMoreButton
    section="services"
    mobileLimit={2}
    tabletLimit={4}
    label="Ver más servicios"
  />

  <footer class="flex justify-center">
    <a
      href="#contact"
      class="inline-flex items-center gap-2 rounded-lg border border-tertiary/60 bg-tertiary/10 px-5 py-2.5 text-sm font-medium text-tertiary duration-300 hover:scale-105 hover:bg-tertiary/20 focus:ring-2 focus:ring-tertiary focus:ring-offset-2 focus:outline-none sm:text-base"
      aria-label="Hablar con SV Tech sin saber qué servicio necesita"
    >
      ¿No estás seguro de qué necesitas? Hablemos
    </a>
  </footer>
</section>

<script>
  import { setupCardVisibility } from 'lib/generic-card-visibility-manager';

  document.addEventListener('astro:page-load', () => {
    setupCardVisibility({
      sectionName: 'services',
      mobileLimit: 2,
      tabletLimit: 4,
      collapsedLabel: 'Ver más servicios',
      expandedLabel: 'Ver menos servicios',
    });
  });
</script>
