---
import { titleProject, subTitleProject } from 'consts/pagesTitle';
import ProjectCard from 'components/cards/ProjectCard.astro';
import ProjectModal from 'components/modals/ProjectModal.astro';
import { PROJECTS_STATIC } from 'consts/projects';
import SeeMoreButton from 'components/ui/SeeMoreButton.astro';
---

<section
  id="projects"
  class="relative flex w-full max-w-[1200px] -scroll-mt-10 flex-col items-center justify-center gap-20 px-2 py-40 md:scroll-mt-6"
>
  <header class="reveal flex w-[90%] flex-col items-center justify-center gap-4 text-center md:w-[100%]">
    <h2 class="text-2xl font-bold text-secondary uppercase duration-300 sm:text-4xl md:text-5xl">
      {titleProject}
    </h2>
    <h3 class="text-sm font-medium text-primary sm:text-lg md:text-3xl">{subTitleProject}</h3>
  </header>

  <div
    id="projects-container"
    class="grid w-full max-w-[1100px] grid-cols-1 place-items-center gap-8 md:grid-cols-2 md:gap-8 lg:gap-10 px-2 sm:px-4"
  >
    {PROJECTS_STATIC.map((project) => <ProjectCard project={project} />)}
  </div>

  <SeeMoreButton
    section="projects"
    mobileLimit={3}
    tabletLimit={4}
    label="Ver más proyectos"
  />
</section>

<!-- Project Modal -->
<ProjectModal />

<script>
  import { setupCardVisibility } from 'lib/managers/generic-card-visibility-manager';
  import { ProjectModalManager } from 'lib/managers/project-modal-manager';

  document.addEventListener('astro:page-load', () => {
    // Configurar visibilidad de tarjetas
    setupCardVisibility({
      sectionName: 'projects',
      mobileLimit: 3,
      tabletLimit: 4,
      collapsedLabel: 'Ver más proyectos',
      expandedLabel: 'Ver menos proyectos',
    });

    // Configurar modal de proyectos
    const modalManager = new ProjectModalManager();
    modalManager.initializeProjectButtons();
  });
</script>
