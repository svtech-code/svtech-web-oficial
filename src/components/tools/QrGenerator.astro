---
import Icon from 'components/ui/Icon.astro';
---

<section
  aria-label="Consola de configuración y vista previa del código QR"
  class="w-full"
>
  <form
    id="qr-generator-form"
    onsubmit="return false;"
    class="grid w-full grid-cols-1 gap-8 lg:grid-cols-12 lg:items-start"
  >
    <!-- Panel Izquierdo: Configuración de Datos y Diseño (7 columnas en desktop) -->
    <div
      class="reveal-left flex flex-col gap-8 rounded-2xl border border-primary/40 bg-gradient-primary/85 p-5 shadow-sm shadow-primary/40 backdrop-blur-2xl sm:p-8 lg:col-span-7"
    >
      <!-- Paso 1: Selector de Tipo de Contenido -->
      <div class="space-y-4">
        <h2 class="text-base font-bold tracking-wide text-primary uppercase sm:text-lg">
          1. Tipo de contenido a codificar
        </h2>

        <div
          role="tablist"
          aria-label="Tipo de contenido del código QR"
          class="grid grid-cols-2 gap-2.5 sm:grid-cols-4"
        >
          <button
            type="button"
            role="tab"
            aria-selected="true"
            data-qr-tab="url"
            class="flex cursor-pointer items-center justify-center gap-2 rounded-lg border border-primary bg-primary px-3 py-2.5 text-xs font-semibold text-gradient-secondary transition-[transform,scale,border-color,background-color,color] duration-300 ease-out hover:scale-[1.02] focus:ring-2 focus:ring-primary focus:outline-none sm:text-sm"
          >
            <svg
              class="size-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
            </svg>
            <span>Sitio / Link</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-qr-tab="whatsapp"
            class="flex cursor-pointer items-center justify-center gap-2 rounded-lg border border-white/10 bg-gradient-primary/60 px-3 py-2.5 text-xs font-semibold text-secondary/80 transition-[transform,scale,border-color,background-color,color] duration-300 ease-out hover:scale-[1.02] hover:border-primary/50 focus:ring-2 focus:ring-primary focus:outline-none sm:text-sm"
          >
            <svg
              class="size-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
            <span>WhatsApp</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-qr-tab="wifi"
            class="flex cursor-pointer items-center justify-center gap-2 rounded-lg border border-white/10 bg-gradient-primary/60 px-3 py-2.5 text-xs font-semibold text-secondary/80 transition-[transform,scale,border-color,background-color,color] duration-300 ease-out hover:scale-[1.02] hover:border-primary/50 focus:ring-2 focus:ring-primary focus:outline-none sm:text-sm"
          >
            <svg
              class="size-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 20h.01" />
              <path d="M2 8.82a15 15 0 0 1 20 0" />
              <path d="M5 12.859a10 10 0 0 1 14 0" />
              <path d="M8.5 16.429a5 5 0 0 1 7 0" />
            </svg>
            <span>Red Wi-Fi</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-qr-tab="vcard"
            class="flex cursor-pointer items-center justify-center gap-2 rounded-lg border border-white/10 bg-gradient-primary/60 px-3 py-2.5 text-xs font-semibold text-secondary/80 transition-[transform,scale,border-color,background-color,color] duration-300 ease-out hover:scale-[1.02] hover:border-primary/50 focus:ring-2 focus:ring-primary focus:outline-none sm:text-sm"
          >
            <svg
              class="size-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="18" height="14" x="3" y="5" rx="2" />
              <circle cx="9" cy="11" r="2" />
              <path d="M15 10h2" />
              <path d="M15 14h2" />
              <path d="M7 15a2 2 0 0 1 4 0" />
            </svg>
            <span>Contacto</span>
          </button>
        </div>

        <!-- Panel URL / Redes Sociales -->
        <div data-qr-panel="url" class="qr-panel-enter space-y-3 pt-2">
          <div>
            <label
              for="qr-url-input"
              class="block text-sm font-medium text-secondary"
            >
              Dirección web, carta PDF, Instagram o Google Maps
            </label>
            <input
              id="qr-url-input"
              name="url_input"
              type="url"
              value="https://svtech.cl"
              placeholder="https://tunegocio.cl/carta-digital"
              autocomplete="off"
              class="mt-1.5 w-full rounded-lg border border-primary/60 bg-white/10 px-4 py-2.5 text-sm text-secondary placeholder:text-secondary/60 backdrop-blur-md transition duration-200 focus:border-transparent focus:ring-2 focus:ring-primary focus:outline-none sm:text-base"
            />
            <p class="mt-1.5 text-xs leading-relaxed text-secondary/75 sm:text-sm">
              La dirección se graba directamente en los puntos del QR: sin acortadores ni redirecciones que caduquen.
            </p>
          </div>
        </div>

        <!-- Panel WhatsApp Directo -->
        <div data-qr-panel="whatsapp" class="qr-panel-enter hidden space-y-4 pt-2">
          <div>
            <label
              for="qr-wa-phone"
              class="block text-sm font-medium text-secondary"
            >
              Número con código de país
            </label>
            <input
              id="qr-wa-phone"
              name="wa_phone"
              type="tel"
              value="+56987933282"
              placeholder="+56 9 8793 3282"
              class="mt-1.5 w-full rounded-lg border border-primary/60 bg-white/10 px-4 py-2.5 text-sm text-secondary placeholder:text-secondary/60 backdrop-blur-md transition duration-200 focus:border-transparent focus:ring-2 focus:ring-primary focus:outline-none sm:text-base"
            />
          </div>

          <div>
            <label
              for="qr-wa-message"
              class="block text-sm font-medium text-secondary"
            >
              Mensaje predeterminado (opcional)
            </label>
            <textarea
              id="qr-wa-message"
              name="wa_message"
              rows="3"
              placeholder="Ej: Hola, quiero hacer un pedido o cotizar un servicio..."
              class="mt-1.5 w-full resize-y rounded-lg border border-primary/60 bg-white/10 px-4 py-2.5 text-sm leading-relaxed text-secondary placeholder:text-secondary/60 backdrop-blur-md transition duration-200 focus:border-transparent focus:ring-2 focus:ring-primary focus:outline-none sm:text-base"
            >Hola, me gustaría cotizar un servicio</textarea>
          </div>

          <p class="text-xs leading-relaxed text-secondary/75 sm:text-sm">
            Genera un enlace oficial <code class="rounded bg-white/10 px-1.5 py-0.5 text-tertiary">wa.me</code> que abre el chat directo en el teléfono de tu cliente.
          </p>
        </div>

        <!-- Panel Red Wi-Fi -->
        <div data-qr-panel="wifi" class="qr-panel-enter hidden space-y-4 pt-2">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label
                for="qr-wifi-ssid"
                class="block text-sm font-medium text-secondary"
              >
                Nombre de la red (SSID)
              </label>
              <input
                id="qr-wifi-ssid"
                name="wifi_ssid"
                type="text"
                placeholder="Ej: WiFi_Clientes"
                class="mt-1.5 w-full rounded-lg border border-primary/60 bg-white/10 px-4 py-2.5 text-sm text-secondary placeholder:text-secondary/60 backdrop-blur-md transition duration-200 focus:border-transparent focus:ring-2 focus:ring-primary focus:outline-none sm:text-base"
              />
            </div>

            <div>
              <label
                for="qr-wifi-password"
                class="block text-sm font-medium text-secondary"
              >
                Contraseña de la red
              </label>
              <input
                id="qr-wifi-password"
                name="wifi_password"
                type="text"
                placeholder="Clave Wi-Fi (procesada solo en tu equipo)"
                autocomplete="off"
                class="mt-1.5 w-full rounded-lg border border-primary/60 bg-white/10 px-4 py-2.5 text-sm text-secondary placeholder:text-secondary/60 backdrop-blur-md transition duration-200 focus:border-transparent focus:ring-2 focus:ring-primary focus:outline-none sm:text-base"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:items-end">
            <div>
              <label
                for="qr-wifi-encryption"
                class="block text-sm font-medium text-secondary"
              >
                Seguridad de red
              </label>
              <div class="relative mt-1.5">
                <select
                  id="qr-wifi-encryption"
                  name="wifi_encryption"
                  class="w-full cursor-pointer appearance-none rounded-lg border border-primary/60 bg-white/10 px-4 py-2.5 pr-10 text-sm text-secondary backdrop-blur-md transition duration-200 focus:border-transparent focus:ring-2 focus:ring-primary focus:outline-none sm:text-base"
                >
                  <option value="WPA" class="bg-gradient-primary text-secondary">WPA / WPA2 / WPA3</option>
                  <option value="WEP" class="bg-gradient-primary text-secondary">WEP</option>
                  <option value="nopass" class="bg-gradient-primary text-secondary">Red abierta (sin clave)</option>
                </select>
                <svg
                  class="pointer-events-none absolute top-1/2 right-3.5 size-4 -translate-y-1/2 text-primary"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </div>
            </div>

            <div>
              <span class="block text-sm font-medium text-secondary">
                Visibilidad
              </span>
              <label
                for="qr-wifi-hidden"
                class="mt-1.5 flex cursor-pointer items-center justify-between rounded-lg border border-primary/60 bg-white/10 px-4 py-2.5 text-sm text-secondary backdrop-blur-md transition duration-200 hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary/15 sm:text-base"
              >
                <span class="font-medium">Red con SSID oculto</span>
                <span class="relative flex items-center">
                  <input
                    id="qr-wifi-hidden"
                    type="checkbox"
                    name="wifi_hidden"
                    class="peer sr-only"
                  />
                  <span
                    aria-hidden="true"
                    class="flex size-5 items-center justify-center rounded border border-primary/60 bg-gradient-primary/80 text-transparent transition duration-200 peer-checked:border-primary peer-checked:bg-primary peer-checked:text-gradient-secondary peer-focus-visible:ring-2 peer-focus-visible:ring-primary"
                  >
                    <svg
                      class="size-3.5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </span>
                </span>
              </label>
            </div>
          </div>
        </div>

        <!-- Panel Contacto vCard 3.0 -->
        <div data-qr-panel="vcard" class="qr-panel-enter hidden space-y-4 pt-2">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="qr-vcard-name" class="block text-sm font-medium text-secondary">
                Nombre completo
              </label>
              <input
                id="qr-vcard-name"
                name="vcard_name"
                type="text"
                placeholder="Ej: Mario Sandoval"
                class="mt-1.5 w-full rounded-lg border border-primary/60 bg-white/10 px-4 py-2.5 text-sm text-secondary placeholder:text-secondary/60 backdrop-blur-md transition duration-200 focus:border-transparent focus:ring-2 focus:ring-primary focus:outline-none sm:text-base"
              />
            </div>
            <div>
              <label for="qr-vcard-org" class="block text-sm font-medium text-secondary">
                Empresa / Organización
              </label>
              <input
                id="qr-vcard-org"
                name="vcard_org"
                type="text"
                placeholder="Ej: SV Tech SpA"
                class="mt-1.5 w-full rounded-lg border border-primary/60 bg-white/10 px-4 py-2.5 text-sm text-secondary placeholder:text-secondary/60 backdrop-blur-md transition duration-200 focus:border-transparent focus:ring-2 focus:ring-primary focus:outline-none sm:text-base"
              />
            </div>
            <div>
              <label for="qr-vcard-title" class="block text-sm font-medium text-secondary">
                Cargo o especialidad
              </label>
              <input
                id="qr-vcard-title"
                name="vcard_title"
                type="text"
                placeholder="Ej: Consultor TI & Desarrollo Web"
                class="mt-1.5 w-full rounded-lg border border-primary/60 bg-white/10 px-4 py-2.5 text-sm text-secondary placeholder:text-secondary/60 backdrop-blur-md transition duration-200 focus:border-transparent focus:ring-2 focus:ring-primary focus:outline-none sm:text-base"
              />
            </div>
            <div>
              <label for="qr-vcard-phone" class="block text-sm font-medium text-secondary">
                Teléfono móvil
              </label>
              <input
                id="qr-vcard-phone"
                name="vcard_phone"
                type="tel"
                placeholder="+56 9 8793 3282"
                class="mt-1.5 w-full rounded-lg border border-primary/60 bg-white/10 px-4 py-2.5 text-sm text-secondary placeholder:text-secondary/60 backdrop-blur-md transition duration-200 focus:border-transparent focus:ring-2 focus:ring-primary focus:outline-none sm:text-base"
              />
            </div>
            <div>
              <label for="qr-vcard-email" class="block text-sm font-medium text-secondary">
                Correo electrónico
              </label>
              <input
                id="qr-vcard-email"
                name="vcard_email"
                type="email"
                placeholder="contacto@svtech.cl"
                class="mt-1.5 w-full rounded-lg border border-primary/60 bg-white/10 px-4 py-2.5 text-sm text-secondary placeholder:text-secondary/60 backdrop-blur-md transition duration-200 focus:border-transparent focus:ring-2 focus:ring-primary focus:outline-none sm:text-base"
              />
            </div>
            <div>
              <label for="qr-vcard-web" class="block text-sm font-medium text-secondary">
                Sitio web
              </label>
              <input
                id="qr-vcard-web"
                name="vcard_web"
                type="url"
                placeholder="https://svtech.cl"
                class="mt-1.5 w-full rounded-lg border border-primary/60 bg-white/10 px-4 py-2.5 text-sm text-secondary placeholder:text-secondary/60 backdrop-blur-md transition duration-200 focus:border-transparent focus:ring-2 focus:ring-primary focus:outline-none sm:text-base"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Paso 2: Geometría y Colores de Marca -->
      <div class="space-y-5 border-t border-white/10 pt-6">
        <h2 class="text-base font-bold tracking-wide text-primary uppercase sm:text-lg">
          2. Estilo geométrico y colores de marca
        </h2>

        <!-- Selector de Módulos (Puntos) -->
        <div class="space-y-2">
          <span class="block text-sm font-medium text-secondary">
            Geometría de los módulos (puntos internos)
          </span>
          <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4">
            <button
              type="button"
              data-qr-dot="rounded"
              aria-pressed="true"
              class="cursor-pointer rounded-lg border border-primary bg-primary/20 px-3 py-2 text-xs font-semibold text-secondary transition-[transform,border-color,background-color] duration-300 ease-out hover:scale-[1.02] focus:ring-2 focus:ring-primary focus:outline-none sm:text-sm"
            >
              Redondeado
            </button>
            <button
              type="button"
              data-qr-dot="square"
              aria-pressed="false"
              class="cursor-pointer rounded-lg border border-white/10 bg-gradient-primary/50 px-3 py-2 text-xs font-semibold text-secondary/75 transition-[transform,border-color,background-color] duration-300 ease-out hover:scale-[1.02] hover:border-primary/50 focus:ring-2 focus:ring-primary focus:outline-none sm:text-sm"
            >
              Clásico
            </button>
            <button
              type="button"
              data-qr-dot="dots"
              aria-pressed="false"
              class="cursor-pointer rounded-lg border border-white/10 bg-gradient-primary/50 px-3 py-2 text-xs font-semibold text-secondary/75 transition-[transform,border-color,background-color] duration-300 ease-out hover:scale-[1.02] hover:border-primary/50 focus:ring-2 focus:ring-primary focus:outline-none sm:text-sm"
            >
              Circular
            </button>
            <button
              type="button"
              data-qr-dot="classy-rounded"
              aria-pressed="false"
              class="cursor-pointer rounded-lg border border-white/10 bg-gradient-primary/50 px-3 py-2 text-xs font-semibold text-secondary/75 transition-[transform,border-color,background-color] duration-300 ease-out hover:scale-[1.02] hover:border-primary/50 focus:ring-2 focus:ring-primary focus:outline-none sm:text-sm"
            >
              Curvo Elegante
            </button>
          </div>
        </div>

        <!-- Selector de Esquinas (Ojos del QR) -->
        <div class="space-y-2">
          <span class="block text-sm font-medium text-secondary">
            Marcadores de esquina (ojos de posicionamiento)
          </span>
          <div class="grid grid-cols-3 gap-2.5">
            <button
              type="button"
              data-qr-corner="extra-rounded"
              aria-pressed="true"
              class="cursor-pointer rounded-lg border border-primary bg-primary/20 px-3 py-2 text-xs font-semibold text-secondary transition-[transform,border-color,background-color] duration-300 ease-out hover:scale-[1.02] focus:ring-2 focus:ring-primary focus:outline-none sm:text-sm"
            >
              Suave
            </button>
            <button
              type="button"
              data-qr-corner="square"
              aria-pressed="false"
              class="cursor-pointer rounded-lg border border-white/10 bg-gradient-primary/50 px-3 py-2 text-xs font-semibold text-secondary/75 transition-[transform,border-color,background-color] duration-300 ease-out hover:scale-[1.02] hover:border-primary/50 focus:ring-2 focus:ring-primary focus:outline-none sm:text-sm"
            >
              Recto
            </button>
            <button
              type="button"
              data-qr-corner="dot"
              aria-pressed="false"
              class="cursor-pointer rounded-lg border border-white/10 bg-gradient-primary/50 px-3 py-2 text-xs font-semibold text-secondary/75 transition-[transform,border-color,background-color] duration-300 ease-out hover:scale-[1.02] hover:border-primary/50 focus:ring-2 focus:ring-primary focus:outline-none sm:text-sm"
            >
              Circular
            </button>
          </div>
        </div>

        <!-- Paletas rápidas seguras para lectura óptica -->
        <div class="space-y-2">
          <span class="block text-sm font-medium text-secondary">
            Combinaciones de alto contraste listas para imprenta
          </span>
          <div class="flex flex-wrap gap-2">
            <button
              type="button"
              data-qr-preset
              data-dots="#001217"
              data-bg="#ffffff"
              class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-medium text-secondary transition duration-300 hover:border-primary focus:ring-2 focus:ring-primary focus:outline-none"
            >
              <span class="size-3.5 rounded-full border border-white/40 bg-[#001217]"></span>
              <span>Abismo SV Tech</span>
            </button>
            <button
              type="button"
              data-qr-preset
              data-dots="#000000"
              data-bg="#ffffff"
              class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-medium text-secondary transition duration-300 hover:border-primary focus:ring-2 focus:ring-primary focus:outline-none"
            >
              <span class="size-3.5 rounded-full border border-white/40 bg-black"></span>
              <span>Negro Puro</span>
            </button>
            <button
              type="button"
              data-qr-preset
              data-dots="#005f75"
              data-bg="#ffffff"
              class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-medium text-secondary transition duration-300 hover:border-primary focus:ring-2 focus:ring-primary focus:outline-none"
            >
              <span class="size-3.5 rounded-full border border-white/40 bg-[#005f75]"></span>
              <span>Cian Corporativo</span>
            </button>
            <button
              type="button"
              data-qr-preset
              data-dots="#1e293b"
              data-bg="#f8fafc"
              class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-medium text-secondary transition duration-300 hover:border-primary focus:ring-2 focus:ring-primary focus:outline-none"
            >
              <span class="size-3.5 rounded-full border border-white/40 bg-[#1e293b]"></span>
              <span>Pizarra Mate</span>
            </button>
          </div>
        </div>

        <!-- Selectores de Color Hexadecimal (Controles planos, sin aspecto de card anidada) -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <label
            for="qr-dots-color"
            class="flex cursor-pointer items-center justify-between rounded-lg border border-primary/50 bg-white/10 px-3.5 py-2.5 backdrop-blur-md transition duration-200 hover:border-primary"
          >
            <div>
              <span class="block text-xs font-medium text-secondary/75">Color de puntos</span>
              <span id="qr-dots-color-hex" class="text-sm font-bold text-secondary">#001217</span>
            </div>
            <input
              id="qr-dots-color"
              type="color"
              value="#001217"
              aria-label="Seleccionar color de los puntos del QR"
              class="size-8 cursor-pointer rounded-lg border border-white/20 bg-transparent"
            />
          </label>

          <label
            for="qr-bg-color"
            class="flex cursor-pointer items-center justify-between rounded-lg border border-primary/50 bg-white/10 px-3.5 py-2.5 backdrop-blur-md transition duration-200 hover:border-primary"
          >
            <div>
              <span class="block text-xs font-medium text-secondary/75">Color de fondo</span>
              <span id="qr-bg-color-hex" class="text-sm font-bold text-secondary">#FFFFFF</span>
            </div>
            <input
              id="qr-bg-color"
              type="color"
              value="#ffffff"
              aria-label="Seleccionar color de fondo del QR"
              class="size-8 cursor-pointer rounded-lg border border-white/20 bg-transparent"
            />
          </label>
        </div>

        <!-- Alerta de Contraste Óptico WCAG (Callout inline limpio) -->
        <div
          id="qr-contrast-alert"
          role="status"
          aria-live="polite"
          class="qr-panel-enter hidden flex-col items-start justify-between gap-3 rounded-lg border border-tertiary/50 bg-tertiary/10 px-4 py-3 sm:flex-row sm:items-center"
        >
          <div class="flex items-start gap-3">
            <svg
