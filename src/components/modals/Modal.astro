---
import ModalLoadingState from './ModalLoadingState.astro';
import ModalSuccessState from './ModalSuccessState.astro';
import ModalErrorState from './ModalErrorState.astro';

export interface Props {
  isOpen?: boolean;
  state?: 'loading' | 'success' | 'error';
  errorMessage?: string;
}

const {
  isOpen = false,
  state = 'success',
  errorMessage = 'Hubo un error al enviar el mensaje. Inténtalo nuevamente.',
} = Astro.props;
---

<div
  id="success-modal"
  role="dialog"
  aria-modal="true"
  class={`modal-overlay ${isOpen ? '' : 'hidden'}`}
  data-state={state}
>
  <div class="modal-content">
    <div class="modal-body">
      <ModalLoadingState state={state} />
      <ModalSuccessState state={state} />
      <ModalErrorState state={state} errorMessage={errorMessage} />
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    transition: all 0.3s ease;
  }

  .modal-overlay.hidden {
    opacity: 0;
    visibility: hidden;
  }

  .modal-content {
    position: relative;
    width: 100%;
    max-width: 500px;
    border-radius: 16px;
    padding: 2rem;
    background: linear-gradient(180deg, rgba(0, 18, 23, 0.94), rgba(0, 37, 45, 0.9));
    border: 1px solid rgba(0, 150, 184, 0.45);
    backdrop-filter: blur(20px);
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.6),
      0 0 24px rgba(0, 150, 184, 0.28);
    transform: scale(0.9);
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .modal-overlay[data-state='error'] .modal-content {
    border-color: rgba(239, 68, 68, 0.55);
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.6),
      0 0 24px rgba(239, 68, 68, 0.3);
  }

  .modal-overlay:not(.hidden) .modal-content {
    transform: scale(1);
  }

  .modal-body {
    text-align: center;
  }

  .modal-state {
    transition: opacity 0.3s ease;
  }

  .modal-state.hidden {
    display: none;
  }

  /* Loading state específico */
  .modal-overlay[data-state='loading'] {
    pointer-events: all;
  }

  .modal-overlay[data-state='loading'] .modal-content {
    pointer-events: none;
  }
</style>
