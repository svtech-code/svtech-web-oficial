---
import ButtonCloseModal from './ButtonCloseModal.astro';
import ProjectTypeBadge from 'components/ui/ProjectTypeBadge.astro';
import ProjectModalAsideInfo from './ProjectModalAsideInfo.astro';
import ProjectModalArticleContent from './ProjectModalArticleContent.astro';
import Icon from 'components/ui/Icon.astro';

interface Props {
  id?: string;
}

const { id = 'project-modal' } = Astro.props;
---

<!-- Project Modal Overlay -->
<article
  id={id}
  class="fixed inset-0 z-50 hidden items-center justify-center border-b-gradient-primary/50 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  aria-describedby="modal-description"
>
  <!-- Modal Container -->
  <div
    id="modal-project-container"
    class="relative mx-4 max-h-[90vh] w-full max-w-4xl overflow-hidden rounded-2xl bg-white/20 p-1 shadow-md backdrop-blur-sm"
    role="document"
  >
    <!-- Close Button -->
    <ButtonCloseModal />

    <!-- Modal Content -->
    <div class="flex max-h-[calc(90vh-0.5rem)] flex-col overflow-hidden rounded-xl">
      <!-- Project Image -->
      <section
        class="relative h-[10rem] w-full flex-shrink-0 overflow-hidden rounded-t-xl md:h-[20rem]"
      >
        <img
          id="modal-project-image"
          src=""
          alt=""
          class="h-full w-full object-cover transition-transform duration-500 ease-out hover:scale-105"
        />
        <!-- Project Type Badge -->
        <div class="absolute top-4 left-4">
          <ProjectTypeBadge divId="modal-project-type-badge" spanId="modal-project-type" />
        </div>
      </section>

      <!-- Scrollable Content Section -->
      <section
        class="modal-scroll flex min-h-0 flex-1 flex-col flex-wrap gap-4 overflow-y-auto scroll-smooth rounded-b-xl bg-gradient-secondary p-4 backdrop-blur-2xl md:flex-row"
      >
        <!-- sidebar info -->
        <ProjectModalAsideInfo />

        <!-- Main content -->
        <ProjectModalArticleContent />

        <!-- Next step -->
        <footer class="flex w-full justify-center pt-2">
          <a
            id="modal-cta"
            href="https://wa.me/56987933282"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-tertiary bg-tertiary/10 px-5 py-2.5 text-sm font-medium text-tertiary transition-[transform,scale,background-color] duration-300 ease-out hover:scale-105 hover:bg-tertiary/20 focus:ring-2 focus:ring-tertiary focus:ring-offset-2 focus:outline-none sm:text-base"
            aria-label="Hablar por WhatsApp sobre un proyecto similar"
          >
            <Icon name="whatsApp" class="h-5 w-5" aria-hidden="true" />
            Hablemos de tu proyecto
          </a>
        </footer>
      </section>
    </div>
  </div>
</article>
