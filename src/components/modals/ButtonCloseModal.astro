---
import Icon from 'components/ui/Icon.astro';
---

<button
  id="close-project-modal"
  class="absolute top-4 right-4 z-10 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-white/80 text-primary transition-[transform,scale,background-color] duration-300 ease-out hover:scale-110 hover:bg-white hover:text-gray-900 focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:outline-none"
  aria-label="Cerrar modal"
  type="button"
>
  <Icon name="close-vector" class="h-8 w-8" aria-hidden="true" />
</button>
