---
import Icon from 'components/ui/Icon.astro';
---

<button
  id="close-project-modal"
  class="absolute top-3 right-3 z-30 flex h-8 w-8 sm:h-9 sm:w-9 cursor-pointer items-center justify-center rounded-full bg-black/60 text-white backdrop-blur-md transition-[transform,scale,background-color] duration-300 ease-out hover:scale-110 hover:bg-black/90 focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:outline-none"
  aria-label="Cerrar modal"
  type="button"
>
  <Icon name="close-vector" class="h-4 w-4 sm:h-5 sm:w-5" aria-hidden="true" />
</button>
