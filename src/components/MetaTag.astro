---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: string;
}

const {
  title = 'Sv Tech | Soporte Informático y Desarrollo Web a Medida',
  description = 'Soporte Informático y Desarrollo de Aplicaciones Web a Medida',
  image = 'https://www.svtech.cl/og.png',
  canonicalURL = Astro.url.href,
  type = 'website',
} = Astro.props;
---

<!-- theme for the top bar of the browser in mobile version -->
<meta name="theme-color" content="#001217" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-status-bar-style" content="#001217" />

<!-- SEO and canonical -->
<link rel="canonical" href={canonicalURL} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:locale" content="es_CL" />
<meta property="og:site_name" content="Sv Tech" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@svtech_code" />
<meta name="twitter:creator" content="@svtech_code" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
