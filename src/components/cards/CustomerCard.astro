---
import type { Customer } from 'types/customer';

interface Props {
  customer: Customer;
}

const { customer } = Astro.props;
const { id, name } = customer;
---

<button
  type="button"
  data-target
  data-customer-id={id}
  aria-label={`Ver información del cliente ${name}`}
  class="flex min-w-[120px] shrink-0 cursor-pointer appearance-none items-center justify-center border-0 bg-transparent p-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-transparent md:min-w-[200px]"
>
  <figure
    class="relative rounded-2xl bg-secondary/30 duration-300 hover:rounded-3xl hover:bg-secondary/40"
  >
    <img
      src={`/images/customers/${id}.webp`}
      alt={name}
      width="640"
      height="640"
      loading="lazy"
      decoding="async"
      class="h-auto w-28 object-contain p-4 duration-300 hover:scale-110 sm:w-40 md:hover:scale-125"
    />
  </figure>
</button>
