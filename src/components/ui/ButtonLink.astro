---
import Icon from './Icon.astro';
import type { IconName } from 'consts/icons';

type Variant = 'amber' | 'primary' | 'ghost';
type Size = 'md' | 'sm';

interface Props {
  href: string;
  variant?: Variant;
  size?: Size;
  external?: boolean;
  ariaLabel?: string;
  icon?: IconName;
  iconClass?: string;
  id?: string;
  class?: string;
}

const {
  href,
  variant = 'amber',
  size = 'md',
  external = false,
  ariaLabel,
  icon,
  iconClass = 'h-4 w-4',
  id,
  class: className = '',
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-xl transition-[transform,scale,border-color,background-color] duration-300 ease-out hover:scale-105 focus:ring-2 focus:ring-offset-2 focus:outline-none';

const variants: Record<Variant, string> = {
  amber:
    'border border-tertiary bg-tertiary/10 text-tertiary hover:bg-tertiary/20 focus:ring-tertiary',
  primary:
    'border border-primary bg-primary text-gradient-secondary hover:bg-primary/90 focus:ring-primary',
  ghost:
    'border border-white/20 bg-white/5 text-secondary hover:border-primary hover:bg-primary/10 hover:text-primary focus:ring-primary',
};

const sizes: Record<Size, string> = {
  md: 'h-11 w-full px-4 text-xs font-semibold sm:text-sm',
  sm: 'w-full px-5 py-2.5 text-sm font-medium sm:w-auto sm:text-base',
};
---

<a
  id={id}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  aria-label={ariaLabel}
  class:list={[base, variants[variant], sizes[size], className]}
>
  {icon && <Icon name={icon} class={iconClass} aria-hidden="true" />}
  <span class="whitespace-nowrap"><slot /></span>
</a>
