---
---

<aside
  id="cookie-consent-banner"
  role="dialog"
  aria-live="polite"
  aria-label="Preferencias de cookies y privacidad"
  class="fixed right-4 bottom-4 left-4 z-40 mx-auto hidden max-w-xl flex-col gap-4 rounded-2xl border border-primary/50 bg-gradient-primary/95 p-5 shadow-lg shadow-primary/20 backdrop-blur-2xl sm:right-6 sm:bottom-6 sm:left-auto"
>
  <div class="space-y-1.5">
    <h2 class="text-sm font-bold tracking-wide text-primary uppercase">
      Privacidad y uso de cookies
    </h2>
    <p class="text-xs leading-relaxed text-secondary/85 sm:text-sm">
      Usamos almacenamiento técnico necesario para la seguridad del formulario y, solo si lo autorizas, cookies analíticas (Google Analytics) para mejorar el sitio. Nuestras herramientas como el Generador QR operan 100% en tu navegador sin enviar datos.{' '}
      <a
        href="/privacidad#cookies"
        class="font-semibold text-tertiary underline decoration-tertiary/60 underline-offset-4 transition-colors hover:text-primary"
      >
        Ver política de privacidad
      </a>
    </p>
  </div>

  <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
    <button
      id="cookie-reject-btn"
      type="button"
      class="cursor-pointer rounded-lg border border-primary/60 bg-transparent px-4 py-2 text-xs font-semibold text-secondary transition duration-300 hover:scale-[1.02] hover:bg-primary/15 focus:ring-2 focus:ring-primary focus:outline-none sm:text-sm"
    >
      Solo necesarias
    </button>
    <button
      id="cookie-accept-btn"
      type="button"
      class="cursor-pointer rounded-lg border border-primary bg-primary px-4 py-2 text-xs font-bold text-gradient-secondary transition duration-300 hover:scale-[1.02] focus:ring-2 focus:ring-primary focus:outline-none sm:text-sm"
    >
      Aceptar analíticas
    </button>
  </div>
</aside>

<script>
  import { initCookieBanner } from 'lib/managers/cookie-consent-manager';

  document.addEventListener('astro:page-load', initCookieBanner);
</script>
