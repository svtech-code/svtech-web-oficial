---
import Icon from 'components/ui/Icon.astro';

interface Props {
  phoneNumber?: string;
  message?: string;
  ariaLabel?: string;
}

const {
  phoneNumber = '56987933282',
  message = 'Hola SV Tech, me gustaría hacer una consulta.',
  ariaLabel = 'Contactar a SV Tech por WhatsApp',
} = Astro.props;

const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
---

<a
  href={whatsappUrl}
  id="whatsapp-floating-btn"
  target="_blank"
  rel="noopener noreferrer"
  class="group fixed right-4 bottom-8 z-40 flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/30 hover:bg-[#20ba59] hover:shadow-xl hover:shadow-[#25D366]/40 hover:scale-105 active:scale-95 focus:ring-2 focus:ring-[#25D366] focus:ring-offset-2 focus:outline-none sm:right-6 sm:bottom-8 sm:h-14 sm:w-14 md:right-8 md:bottom-8 md:h-16 md:w-16"
  aria-label={ariaLabel}
>
  <!-- Indicador online verde -->
  <span class="absolute top-1 right-1 flex h-3 w-3" aria-hidden="true">
    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-200 opacity-75"></span>
    <span class="relative inline-flex h-3 w-3 rounded-full bg-white ring-2 ring-[#25D366]"></span>
  </span>

  <!-- Icono WhatsApp -->
  <Icon
    name="whatsApp"
    class="h-6 w-6 transition-transform duration-300 group-hover:scale-110 sm:h-7 sm:w-7 md:h-8 md:w-8"
  />

  <!-- Tooltip descriptivo en desktop -->
  <span
    role="tooltip"
    class="pointer-events-none absolute right-full mr-3 hidden whitespace-nowrap rounded-lg border border-white/10 bg-gray-900/95 px-3 py-1.5 text-xs font-medium text-white opacity-0 shadow-lg backdrop-blur-sm transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100 translate-x-1 sm:inline-block"
  >
    ¿Necesitas ayuda? Escríbenos
  </span>
</a>

<style>
  #whatsapp-floating-btn {
    transform: translateY(0);
    transition:
      transform 350ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 200ms ease,
      background-color 200ms ease;
  }

  /* Elevación cuando ScrollToTop entra en pantalla: altura del botón inferior + separación equilibrada (~12px móvil/tablet, ~14px desktop) */
  #whatsapp-floating-btn.elevated {
    /* Móvil: h-12 (48px) + 12px gap = 60px (3.75rem) */
    transform: translateY(-3.75rem);
  }

  @media (min-width: 640px) {
    #whatsapp-floating-btn.elevated {
      /* Tablet: h-14 (56px) + 12px gap = 68px (4.25rem) */
      transform: translateY(-4.25rem);
    }
  }

  @media (min-width: 768px) {
    #whatsapp-floating-btn.elevated {
      /* Desktop: h-16 (64px) + 14px gap = 78px (4.875rem) */
      transform: translateY(-4.875rem);
    }
  }
</style>

<script>
  let cleanupWhatsApp: (() => void) | null = null;

  const setupWhatsAppFloating = () => {
    if (cleanupWhatsApp) {
      cleanupWhatsApp();
    }

    const whatsappBtn = document.getElementById('whatsapp-floating-btn');
    if (!whatsappBtn) return;

    const handleToggle = (e: Event) => {
      const customEvent = e as CustomEvent<{ isVisible: boolean }>;
      const isVisible = Boolean(customEvent.detail?.isVisible);
      if (isVisible) {
        whatsappBtn.classList.add('elevated');
      } else {
        whatsappBtn.classList.remove('elevated');
      }
    };

    window.addEventListener('sv:scroll-to-top-toggle', handleToggle);

    // Si ScrollToTop ya estaba visible al cargar/restaurar
    const scrollToTopBtn = document.getElementById('scroll-to-top');
    if (scrollToTopBtn?.classList.contains('is-visible')) {
      whatsappBtn.classList.add('elevated');
    }

    cleanupWhatsApp = () => {
      window.removeEventListener('sv:scroll-to-top-toggle', handleToggle);
    };
  };

  document.addEventListener('astro:page-load', setupWhatsAppFloating);
</script>
