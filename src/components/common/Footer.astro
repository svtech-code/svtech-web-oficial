---
import { SERVICES_STATIC } from 'consts/services';
---

<footer class="relative flex w-full items-center justify-center bg-black/60">
  <div class="relative my-4 flex w-full max-w-[1200px] flex-col items-center justify-center">
    <div class="flex w-full flex-col justify-between gap-10 md:flex-row md:gap-16">
      <a
        href="/"
        class="flex items-center justify-center rounded-2xl focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:outline-none"
        aria-label="Ir al inicio"
      >
        <img
          src="/images/logo.svg"
          alt="SV Tech"
          width="1920"
          height="720"
          class="h-auto w-60 md:w-80"
        />
      </a>

      <nav
        class="flex flex-col items-center justify-center gap-10 pb-4 sm:flex-row sm:flex-wrap sm:items-start sm:justify-around md:flex-1 lg:gap-12"
        aria-label="Barra de navegación del footer"
      >
        <div>
          <h2>ENLACES</h2>
          <ul>
            <li><a href="/#inicio">Inicio</a></li>
            <li><a href="/#servicios">Servicios</a></li>
            <li><a href="/#proyectos">Proyectos</a></li>
            <li><a href="/#clientes">Clientes</a></li>
            <li><a href="/#nosotros">Nosotros</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/#contacto">Contacto</a></li>
          </ul>
        </div>

        <div>
          <h2>SERVICIOS</h2>
          <ul>
            {SERVICES_STATIC.map(({ title, slug }) => (
              <li>
                <a href={`/servicios/${slug}`}>{title}</a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2>HERRAMIENTAS</h2>
          <ul>
            <li>
              <a href="/herramientas/generador-qr">Generador de Códigos QR</a>
            </li>
          </ul>
        </div>

        <div>
          <h2>CONTACTO</h2>
          <ul>
            <li>
              <a href="https://wa.me/56987933282" target="_blank" rel="noopener noreferrer"
                >WhatsApp</a
              >
            </li>
            <li><a href="mailto:contacto@svtech.cl">Correo Electrónico</a></li>
            <li class="footer-plain">Linares, Maule. Chile.</li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="relative flex w-full items-center justify-center py-2">
      <span class={`bg-tertiary/40 h-[3px] w-full block relative overflow-hidden`}>
        <div class="dot"></div>
      </span>
    </div>

    <div class="flex flex-col items-center justify-between gap-2 py-2 text-center text-xs text-secondary md:w-full md:flex-row md:px-4 md:text-sm">
      <p>
        Copyright &copy; {new Date().getFullYear()} SV Tech SpA
        <span aria-hidden="true" class="hidden md:inline">|</span>
        <br aria-hidden="true" class="block md:hidden" />
        Todos los derechos reservados.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 text-xs text-secondary/80">
        <a
          href="/privacidad"
          class="rounded transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          Política de Privacidad
        </a>
        <span aria-hidden="true" class="text-tertiary/60">·</span>
        <a
          href="/aviso-legal"
          class="rounded transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          Aviso Legal
        </a>
        <span aria-hidden="true" class="text-tertiary/60">·</span>
        <button
          type="button"
          data-open-cookie-settings
          class="cursor-pointer rounded transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          Preferencias de cookies
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  nav > div,
  ul {
    text-align: center;
  }

  h2 {
    padding-bottom: 8px;
    color: var(--color-primary);
    font-size: 1.4rem;
    font-weight: 500;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li a {
    display: inline-block;
    transform-origin: center;
    transition-duration: 300ms;
    color: var(--color-secondary);
    text-decoration: none;
    border-radius: 8px;
  }

  li a:hover {
    scale: 1.05;
  }

  li a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 8px;
  }

  .footer-plain {
    color: var(--color-secondary);
  }

  .dot {
    width: 10px; /* Círculo más grande para sobresalir de la línea */
    height: 10px;
    background-color: var(--color-tertiary);
    border-radius: 50%;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    animation: moveDot 8s ease-in-out infinite;
    box-shadow:
      0 0 15px var(--color-secondary),
      -10px 0 10px var(--color-primary);
  }

  @media (width >= 40rem) {
    nav > div,
    ul {
      text-align: start;
    }

    li a {
      transform-origin: left;
    }

    h2 {
      font-size: 1rem;
    }
  }
</style>
