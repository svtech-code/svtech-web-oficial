---
import NavbarButton from './NavbarButton.astro';
import NavbarDesktop from './NavbarDesktop.astro';
import NavbarMobile from './NavbarMobile.astro';
---

<NavbarButton />

<header
  class="fixed top-0 z-30 mx-auto flex h-20 w-full items-center justify-center duration-300 md:h-24 lg:top-4"
>
  <NavbarDesktop />
  <NavbarMobile />
</header>

<div data-target class="absolute top-[60px]"></div>

<script>
  import { functionHeader } from 'lib/managers/function-header';

  document.addEventListener('astro:page-load', () => {
    functionHeader();
  });
</script>
