---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from 'layouts/Layout.astro';
import Icon from 'components/ui/Icon.astro';
import PageBreadcrumb from 'components/ui/PageBreadcrumb.astro';
import BackLink from 'components/ui/BackLink.astro';
import DetailSidebar from 'components/ui/DetailSidebar.astro';
import RelatedList from 'components/ui/RelatedList.astro';
import CtaBanner from 'components/ui/CtaBanner.astro';
import ProseContent from 'components/ui/ProseContent.astro';
import DetailHeader from 'components/ui/DetailHeader.astro';
import ServiceIcon from 'components/ui/ServiceIcon.astro';
import type { ServiceSlug } from 'consts/iconsMap';

export const prerender = true;

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { slug } = Astro.params;
const service = Astro.props.service || (slug ? await getEntry('services', slug) : null);

if (!service) {
  return Astro.redirect('/404');
}

const allServices = await getCollection('services');
const otherServices = allServices
  .filter((s) => s.slug !== service.slug)
  .sort((a, b) => a.data.order - b.data.order);

const { data } = service;
const { title, image, imageAlt, description } = data;

const { Content } = await render(service);

const ctaBySlug: Record<string, { label: string; message: string }> = {
  'consultoria-ti': {
    label: 'Solicitar diagnóstico sin costo',
    message:
      'Hola SV Tech, me gustaría solicitar un diagnóstico inicial sin costo para evaluar la infraestructura tecnológica de mi empresa.',
  },
  'soporte-informatico': {
    label: 'Solicitar soporte técnico',
    message: 'Hola SV Tech, necesito soporte técnico para los equipos de mi empresa.',
  },
  'desarrollo-web': {
    label: 'Cotizar mi sitio web',
    message: 'Hola SV Tech, me gustaría cotizar el desarrollo de un sitio web a medida para mi negocio.',
  },
  'administracion-hosting': {
    label: 'Cotizar administración de hosting',
    message: 'Hola SV Tech, necesito asesoría para la administración de hosting y servidores de mi empresa.',
  },
  'base-datos': {
    label: 'Cotizar bases de datos',
    message:
      'Hola SV Tech, necesito asesoría en diseño, implementación o mantenimiento de bases de datos.',
  },
  'soporte-personalizado': {
    label: 'Solicitar soporte personalizado',
    message: 'Hola SV Tech, me gustaría coordinar un soporte personalizado para mi proyecto.',
  },
};

const cta = ctaBySlug[service.slug] ?? {
  label: 'Contáctanos',
  message: `Hola SV Tech, me gustaría solicitar información y cotizar el servicio de ${title}.`,
};
const whatsappUrl = `https://wa.me/56987933282?text=${encodeURIComponent(cta.message)}`;

const siteUrl = Astro.site ?? new URL('https://svtech.cl');
const serviceUrl = new URL(Astro.url.pathname, siteUrl).href;
const serviceImage = image.startsWith('http') ? image : new URL(image, siteUrl).href;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${serviceUrl}#service`,
      name: title,
      description: description,
      image: serviceImage,
      provider: {
        '@type': 'LocalBusiness',
        name: 'SV Tech',
        url: 'https://svtech.cl',
        logo: 'https://svtech.cl/favicon.svg',
        telephone: '+56987933282',
        areaServed: {
          '@type': 'Country',
          name: 'Chile',
        },
      },
      areaServed: {
        '@type': 'Country',
        name: 'Chile',
      },
      url: serviceUrl,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${serviceUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://svtech.cl',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Servicios',
          item: 'https://svtech.cl/#servicios',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: title,
          item: serviceUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title={`${title} para Empresas | SV Tech`}
  description={description}
  image={image}
  type="article"
  showSmokeScreen={false}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <div
    class="relative flex w-full max-w-[1200px] flex-col gap-10 px-4 pt-28 pb-24 md:pt-36 md:pb-32 lg:flex-row lg:items-start lg:gap-10"
  >
    <!-- Columna Principal: Detalle del Servicio -->
    <article class="relative flex w-full min-w-0 flex-1 flex-col gap-8">
      <!-- Breadcrumbs -->
      <PageBreadcrumb
        items={[
          { label: 'Inicio', href: '/' },
          { label: 'Servicios', href: '/#servicios' },
          { label: title },
        ]}
      />

      <!-- Header del Servicio -->
      <DetailHeader
        title={title}
        description={description}
        imageSrc={image}
        imageAlt={imageAlt}
        titleTransitionName={`service-title-${service.slug}`}
        imageHover
      >
        <div
          slot="eyebrow"
          class="inline-flex items-center gap-2 text-xs font-semibold tracking-wide text-primary uppercase"
        >
          <ServiceIcon name={service.slug as ServiceSlug} class="h-3.5 w-3.5" />
          <span>Servicio Especializado</span>
        </div>
      </DetailHeader>

      <!-- Contenido Markdown Renderizado -->
      <ProseContent variant="page">
        <Content />
      </ProseContent>

      <!-- Banner CTA Final de Conversión -->
      <CtaBanner
        heading="¿Listo para poner en marcha tu requerimiento?"
        text="Escríbenos directamente por WhatsApp o envíanos un mensaje por nuestro formulario web."
        whatsappUrl={whatsappUrl}
        whatsappLabel={cta.label}
        whatsappAriaLabel={`Contactar por WhatsApp para ${title}`}
      />
    </article>

    <!-- Columna Lateral: Sidebar Sticky con Horarios, Otros Servicios e Info -->
    <DetailSidebar>
      <!-- Bloque 1: Horarios de Atención & Cobertura -->
      <div
        class="reveal-card rounded-2xl border border-primary/40 bg-gradient-primary/90 p-6 shadow-xl shadow-black/30 backdrop-blur-xl transition-[border-color,box-shadow] duration-300 hover:border-primary/60 hover:shadow-2xl hover:shadow-primary/10"
      >
        <div class="flex items-center gap-2">
          <Icon name="clock" class="h-4 w-4 text-primary" aria-hidden="true" />
          <span class="text-xs font-bold tracking-wider text-primary uppercase">
            Horarios de Atención
          </span>
        </div>

        <h3 class="mt-2 text-base font-bold text-secondary">Disponibilidad y Cobertura</h3>
        <p class="mt-1.5 text-xs leading-relaxed text-secondary/75">
          Atención técnica en Linares y la Región del Maule, y soporte remoto para todo Chile.
        </p>

        <div class="mt-4 space-y-3 border-t border-white/10 pt-4 text-xs text-secondary/85">
          <div class="flex items-center justify-between">
            <span class="flex items-center gap-1.5 font-medium text-secondary/70">
              <Icon name="calendar" class="h-3.5 w-3.5 text-tertiary" aria-hidden="true" />
              Días:
            </span>
            <span class="font-semibold text-secondary">Lunes a Sábado</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-secondary/70">Jornada Mañana:</span>
            <span class="font-semibold text-primary">09:00 - 14:00 hrs.</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-secondary/70">Jornada Tarde:</span>
            <span class="font-semibold text-primary">15:00 - 20:00 hrs.</span>
          </div>
        </div>
      </div>

      <!-- Bloque 2: Otros Servicios de SV Tech -->
      <RelatedList
        title="Otros Servicios"
        seeAllHref="/#servicios"
        class="transition-[border-color,box-shadow] duration-300 hover:border-white/20 hover:shadow-2xl"
        items={otherServices.map((otherService) => ({
          href: `/servicios/${otherService.slug}`,
          label: otherService.data.title,
          icon: otherService.slug as ServiceSlug,
          tone: 'primary',
        }))}
      />

      <!-- Bloque 3: Valores y Compromiso SV Tech -->
      <div
        class="reveal-card reveal-delay-2 rounded-2xl border border-white/10 bg-gradient-secondary/50 p-6 shadow-xl shadow-black/30 backdrop-blur-xl transition-[border-color,box-shadow] duration-300 hover:border-white/20 hover:shadow-2xl"
      >
        <h3 class="text-xs font-bold tracking-wider text-primary uppercase">¿Por qué SV Tech?</h3>
        <ul class="mt-3.5 space-y-2.5 text-xs text-secondary/80">
          <li class="flex items-start gap-2">
            <span class="font-bold text-tertiary">✓</span>
            <span
              ><strong>Atención personalizada:</strong> Soluciones adaptadas a los procesos de tu negocio.</span
            >
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-tertiary">✓</span>
            <span
              ><strong>Cercanía local:</strong> Presencia en Linares y la Región del Maule con trato humano
              directo.</span
            >
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-tertiary">✓</span>
            <span
              ><strong>Soporte continuo:</strong> Acompañamiento y mantención técnica después de cada
              entrega.</span
            >
          </li>
        </ul>
      </div>
    </DetailSidebar>
  </div>

  <!-- Botón Volver al Catálogo de Servicios (Cierre Global) -->
  <BackLink href="/#servicios" label="Volver a todos los servicios" />
</Layout>
