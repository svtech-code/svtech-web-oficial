---
import Layout from 'layouts/Layout.astro';
import PageBreadcrumb from 'components/ui/PageBreadcrumb.astro';
import BackLink from 'components/ui/BackLink.astro';
import QrGenerator from 'components/tools/QrGenerator.astro';
import QrSeoContent from 'components/tools/QrSeoContent.astro';
import QrFaqSection from 'components/tools/QrFaqSection.astro';
import { QR_FAQ_ITEMS } from 'consts/qrFaq';

export const prerender = true;

const pageTitle = 'Generador de Códigos QR Gratis con Logo y Sin Caducidad | SV Tech';
const pageDescription =
  'Crea códigos QR estáticos 100% gratis, sin registro y que nunca vencen. Personaliza colores, inserta el logo de tu empresa y descarga en PNG o SVG vectorial para imprenta.';
const canonicalUrl = 'https://svtech.cl/herramientas/generador-qr';

const toolSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${canonicalUrl}#webapp`,
      name: 'Generador de Códigos QR Estáticos SV Tech',
      url: canonicalUrl,
      description: pageDescription,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'All',
      inLanguage: 'es-CL',
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://svtech.cl/#website',
      },
      provider: {
        '@type': 'ProfessionalService',
        '@id': 'https://svtech.cl/#localbusiness',
        name: 'SV Tech',
        url: 'https://svtech.cl',
      },
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'CLP',
      },
      featureList:
        'Generación de códigos QR estáticos sin fecha de caducidad, inserción de logo propio en memoria local, modos para URL, WhatsApp, Wi-Fi y Contacto vCard, validación de contraste óptico y descarga en PNG y SVG vectorial',
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: QR_FAQ_ITEMS.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://svtech.cl',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Generador de Códigos QR',
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalUrl}
  showSmokeScreen={false}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(toolSchema)} />

  <div
    class="relative flex w-full max-w-[1200px] flex-col gap-12 px-4 pt-28 pb-20 md:pt-36 md:pb-28"
  >
    <PageBreadcrumb
      items={[
        { label: 'Inicio', href: '/' },
        { label: 'Herramientas Comunidad' },
        { label: 'Generador de Códigos QR' },
      ]}
    />

    <!-- Encabezado Principal Above the Fold -->
    <header class="flex flex-col gap-3">
      <h1
        class="text-2xl leading-tight font-bold text-secondary uppercase sm:text-4xl md:text-5xl"
      >
        Generador de Códigos QR Gratis{' '}
        <span class="text-primary">con Logo y Sin Caducidad</span>
      </h1>
      <p class="max-w-[70ch] text-sm leading-relaxed font-medium text-secondary/85 sm:text-base md:text-lg">
        Herramienta comunitaria de uso libre desarrollada por <strong>SV Tech</strong>. 100% estáticos, procesados de forma privada en tu navegador y con calidad vectorial lista para imprenta.
      </p>
    </header>

    <!-- Consola Interactiva Client-Side -->
    <QrGenerator />

    <!-- Bloque Educativo SEO y Tabla Comparativa -->
    <QrSeoContent />

    <!-- Preguntas Frecuentes (<details>/<summary>) -->
    <QrFaqSection />
  </div>

  <BackLink href="/" label="Volver al inicio de SV Tech" />
</Layout>
