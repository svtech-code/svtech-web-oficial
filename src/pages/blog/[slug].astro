---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from 'layouts/Layout.astro';
import Icon from 'components/ui/Icon.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { slug } = Astro.params;
const post = Astro.props.post || (slug ? await getEntry('blog', slug) : null);

if (!post) {
  return Astro.redirect('/404');
}

const allPosts = await getCollection('blog');
const otherPosts = allPosts
  .filter((p) => p.slug !== slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const { data } = post;
const {
  title,
  description,
  pubDate,
  author,
  category,
  image,
  imageAlt,
  readTime,
  downloadUrl,
  officialUrl,
  tags,
} = data;

const officialLink = officialUrl || downloadUrl;

const { Content } = await render(post);

const formattedDate = new Intl.DateTimeFormat('es-CL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);
---

<Layout
  title={`${title} | Blog SV Tech`}
  description={description}
  image={image}
  type="article"
  showSmokeScreen={false}
>
  <div
    class="relative flex w-full max-w-[1200px] flex-col gap-10 px-4 pt-28 pb-24 md:pt-36 md:pb-32 lg:flex-row lg:items-start lg:gap-10"
  >
    <!-- Columna Principal: Artículo -->
    <article class="relative flex w-full min-w-0 flex-1 flex-col gap-8">
      <!-- Breadcrumbs & Volver -->
      <nav
        aria-label="Breadcrumb"
        class="flex items-center gap-2 text-xs font-medium text-secondary/60 sm:text-sm"
      >
        <a href="/" class="transition-colors hover:text-primary">Inicio</a>
        <span>/</span>
        <a href="/blog" class="transition-colors hover:text-primary">Blog</a>
        <span>/</span>
        <span class="truncate text-secondary/90">{title}</span>
      </nav>

      <!-- Header del Artículo -->
      <header class="space-y-6">
        <div class="space-y-4">
          <h1
            class="text-2xl leading-tight font-bold text-secondary sm:text-3xl md:text-4xl"
            transition:name={`blog-title-${slug}`}
          >
            {title}
          </h1>

          <p class="text-base leading-relaxed text-secondary/80 sm:text-lg">
            {description}
          </p>

          <!-- Barra de Autor, Fecha y Tiempo de lectura -->
          <div
            class="flex items-center justify-between gap-4 border-t border-b border-white/10 py-3"
          >
            <!-- Información del autor -->
            <div class="flex items-center gap-3">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/20 text-xs font-bold text-primary"
              >
                SV
              </div>
              <div>
                <p class="text-xs font-semibold text-secondary sm:text-sm">
                  Publicado por {author}
                </p>
                <p class="text-[11px] text-secondary/60">Equipo de Ingeniería y Soporte TI</p>
              </div>
            </div>

            <!-- Fecha y tiempo de lectura apilados a la derecha -->
            <div class="text-right">
              <time
                datetime={pubDate.toISOString()}
                class="block text-xs font-medium text-tertiary/80 sm:text-sm"
              >
                {formattedDate}
              </time>
              <p class="text-[11px] font-medium text-tertiary/70 sm:text-xs">
                {readTime}
              </p>
            </div>
          </div>
        </div>

        <!-- Imagen destacada del artículo con View Transition -->
        <figure
          class="relative aspect-[16/9] w-full overflow-hidden rounded-2xl border border-white/10 bg-gradient-secondary/50 shadow-2xl shadow-black/50"
        >
          <img
            src={image}
            alt={imageAlt}
            loading="eager"
            decoding="async"
            transition:name={`blog-image-${slug}`}
            class="h-full w-full object-cover"
          />
        </figure>
      </header>

      <!-- Banner de Sitio Web Oficial si aplica -->
      {
        officialLink && (
          <section class="flex flex-col items-center justify-between gap-4 rounded-2xl border border-primary/40 bg-gradient-primary/90 p-5 shadow-lg backdrop-blur-xl sm:flex-row sm:p-6">
            <div class="space-y-1 text-center sm:text-left">
              <span class="text-xs font-bold tracking-wider text-primary uppercase">
                Sitio Web Oficial
              </span>
              <p class="text-sm font-medium text-secondary">
                Accede de forma segura al portal oficial del desarrollador para tu sistema
                operativo.
              </p>
            </div>
            <a
              href={officialLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex flex-shrink-0 items-center gap-2 rounded-xl border border-primary bg-primary/10 px-5 py-2.5 text-sm font-semibold text-primary transition-[transform,scale,background-color] duration-300 ease-out hover:scale-105 hover:bg-primary/20 focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:outline-none"
              aria-label="Visitar web oficial"
            >
              <Icon name="open-vector" class="h-4 w-4" aria-hidden="true" />
              <span>Visitar web oficial</span>
            </a>
          </section>
        )
      }

      <!-- Contenido Markdown Renderizado con Tailwind Typography -->
      <main
        class="prose max-w-none prose-invert prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-secondary prose-h2:mt-16 prose-h2:mb-5 prose-h2:text-xl sm:prose-h2:mt-20 sm:prose-h2:mb-6 sm:prose-h2:text-2xl prose-h3:mt-8 prose-h3:mb-4 prose-h3:text-lg sm:prose-h3:text-xl prose-p:leading-relaxed prose-p:text-secondary/85 prose-a:font-medium prose-a:text-primary prose-a:underline prose-a:decoration-primary/40 prose-a:underline-offset-4 prose-a:transition-colors prose-a:hover:text-tertiary prose-a:hover:decoration-tertiary prose-blockquote:my-6 prose-blockquote:rounded-r-xl prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:bg-primary/10 prose-blockquote:px-5 prose-blockquote:py-3.5 prose-blockquote:text-secondary/90 prose-blockquote:not-italic prose-blockquote:shadow-sm prose-strong:font-semibold prose-strong:text-secondary prose-code:rounded-md prose-code:bg-white/10 prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-sm prose-code:font-normal prose-code:text-tertiary prose-code:before:content-none prose-code:after:content-none prose-ol:my-5 prose-ol:space-y-2.5 prose-ul:my-5 prose-ul:space-y-2 prose-li:text-secondary/85 prose-li:marker:text-primary prose-img:rounded-2xl prose-img:border prose-img:border-white/10 prose-img:shadow-xl prose-hr:my-12 prose-hr:border-white/10"
      >
        <Content />
      </main>

      <!-- Tags -->
      {
        tags.length > 0 && (
          <footer class="mt-4 flex flex-wrap items-center gap-2 border-t border-white/10 pt-6">
            <span class="text-xs font-medium text-secondary/60">Etiquetas:</span>
            {tags.map((tag) => (
              <span class="rounded-lg border border-white/10 bg-white/5 px-2.5 py-1 text-xs font-medium text-secondary/80">
                #{tag}
              </span>
            ))}
          </footer>
        )
      }

      <!-- CTA Final: Soporte / Asesoría WhatsApp -->
      <section
        class="mt-6 flex flex-col items-center justify-between gap-6 rounded-2xl border border-tertiary/40 bg-gradient-secondary p-6 text-center sm:flex-row sm:text-left"
      >
        <div class="space-y-1.5">
          <h3 class="text-lg font-bold text-secondary sm:text-xl">
            {
              category === 'soporte'
                ? '¿Tienes dudas o necesitas asistencia con este proceso?'
                : '¿Requieres asesoría técnica o soporte para tu empresa?'
            }
          </h3>
          <p class="text-xs text-secondary/80 sm:text-sm">
            {
              category === 'soporte'
                ? 'Comunícate directamente con nuestro equipo por WhatsApp para guiarte en tiempo real.'
                : 'Conversa con nuestros especialistas para resolver requerimientos técnicos o de infraestructura.'
            }
          </p>
        </div>

        <a
          href="https://wa.me/56987933282"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex flex-shrink-0 items-center gap-2 rounded-xl border border-tertiary bg-tertiary/10 px-5 py-2.5 text-sm font-semibold text-tertiary transition-[transform,scale,background-color] duration-300 ease-out hover:scale-105 hover:bg-tertiary/20 focus:ring-2 focus:ring-tertiary focus:ring-offset-2 focus:outline-none"
          aria-label="Contactar a soporte por WhatsApp"
        >
          <Icon name="whatsApp" class="h-4 w-4" aria-hidden="true" />
          <span>Hablar con Soporte</span>
        </a>
      </section>
    </article>

    <!-- Columna Lateral: Aside Sticky con Otras Guías, Redes Sociales y Contacto -->
    <aside
      class="relative flex w-full flex-col gap-6 lg:sticky lg:top-36 lg:w-[340px] lg:flex-shrink-0"
    >
      <!-- Bloque: Otras Guías (si hay más disponibles, primero para retención) -->
      {
        otherPosts.length > 0 && (
          <div class="reveal-card rounded-2xl border border-white/10 bg-gradient-secondary/50 p-6 shadow-xl shadow-black/30 backdrop-blur-xl transition-[border-color,box-shadow] duration-300 hover:border-white/20 hover:shadow-2xl">
            <div class="flex items-center justify-between">
              <h3 class="text-xs font-bold tracking-wider text-primary uppercase">Otras Guías</h3>
              <a
                href="/blog"
                class="text-[11px] font-medium text-tertiary transition-colors hover:text-primary hover:underline"
              >
                Ver todas →
              </a>
            </div>

            <div class="mt-4 flex flex-col gap-3.5 divide-y divide-white/5">
              {otherPosts.map((otherPost) => (
                <a
                  href={`/blog/${otherPost.slug}`}
                  class="group flex items-center gap-3 pt-3.5 transition-all duration-300 first:pt-0 hover:opacity-90"
                >
                  <figure class="relative h-14 w-14 flex-shrink-0 overflow-hidden rounded-lg border border-white/10 bg-white/5">
                    <img
                      src={otherPost.data.image}
                      alt={otherPost.data.imageAlt}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-110"
                    />
                  </figure>
                  <div class="flex min-w-0 flex-1 flex-col">
                    <h4 class="line-clamp-2 text-xs font-semibold text-secondary transition-colors group-hover:text-primary">
                      {otherPost.data.title}
                    </h4>
                    <span class="mt-1 text-[11px] text-secondary/50">
                      {otherPost.data.readTime}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }

      <!-- Bloque: Redes Sociales & Comunidad -->
      <div
        class="reveal-card reveal-delay-1 rounded-2xl border border-white/10 bg-gradient-secondary/50 p-6 shadow-xl shadow-black/30 backdrop-blur-xl transition-[border-color,box-shadow] duration-300 hover:border-white/20 hover:shadow-2xl"
      >
        <h3 class="text-xs font-bold tracking-wider text-primary uppercase">Comunidad & Redes</h3>
        <p class="mt-2 text-xs leading-relaxed text-secondary/70">
          Únete a nuestros canales oficiales para enterarte de novedades, tips y soporte directo.
        </p>

        <div class="mt-5 flex flex-col gap-3">
          <!-- Botón Discord -->
          <a
            href="https://discord.gg/DUhM8uc3HM"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between rounded-xl border border-[#5865F2]/30 bg-[#5865F2]/10 p-3 text-secondary transition-[transform,scale,border-color,background-color,box-shadow] duration-300 ease-out hover:scale-[1.02] hover:border-[#5865F2] hover:bg-[#5865F2]/20 hover:shadow-md hover:shadow-[#5865F2]/20 focus:ring-2 focus:ring-[#5865F2] focus:outline-none"
            aria-label="Unirse a la comunidad de Discord de SV Tech"
          >
            <div class="flex items-center gap-3">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-lg bg-[#5865F2]/20 text-[#5865F2] transition-transform duration-300 ease-out group-hover:scale-110"
              >
                <Icon name="discord" class="h-5 w-5" aria-hidden="true" />
              </div>
              <div class="text-left">
                <span class="block text-xs font-bold text-secondary group-hover:text-white"
                  >Discord</span
                >
                <span class="block text-[11px] text-secondary/60">Comunidad técnica</span>
              </div>
            </div>
            <Icon
              name="open-vector"
              class="h-3.5 w-3.5 text-secondary/40 transition-[colors,transform] duration-300 group-hover:translate-x-0.5 group-hover:text-white"
              aria-hidden="true"
            />
          </a>

          <!-- Botón Instagram -->
          <a
            href="https://www.instagram.com/svtech_code/"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between rounded-xl border border-[#E1306C]/30 bg-[#E1306C]/10 p-3 text-secondary transition-[transform,scale,border-color,background-color,box-shadow] duration-300 ease-out hover:scale-[1.02] hover:border-[#E1306C] hover:bg-[#E1306C]/20 hover:shadow-md hover:shadow-[#E1306C]/20 focus:ring-2 focus:ring-[#E1306C] focus:outline-none"
            aria-label="Seguir a SV Tech en Instagram"
          >
            <div class="flex items-center gap-3">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-lg bg-[#E1306C]/20 text-[#E1306C] transition-transform duration-300 ease-out group-hover:scale-110"
              >
                <Icon name="instagram" class="h-5 w-5" aria-hidden="true" />
              </div>
              <div class="text-left">
                <span class="block text-xs font-bold text-secondary group-hover:text-white"
                  >Instagram</span
                >
                <span class="block text-[11px] text-secondary/60">@svtech_code</span>
              </div>
            </div>
            <Icon
              name="open-vector"
              class="h-3.5 w-3.5 text-secondary/40 transition-[colors,transform] duration-300 group-hover:translate-x-0.5 group-hover:text-white"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>

      <!-- Bloque: Contacto / Asesoría SV Tech -->
      <div
        class="reveal-card reveal-delay-2 rounded-2xl border border-primary/30 bg-gradient-primary/80 p-6 shadow-xl shadow-black/30 backdrop-blur-xl transition-[border-color,box-shadow] duration-300 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/20"
      >
        <span class="text-xs font-bold tracking-wider text-primary uppercase">
          ¿Proyecto o Consulta TI?
        </span>
        <h3 class="mt-1.5 text-base font-bold text-secondary">Hablemos de tus requerimientos</h3>
        <p class="mt-2 text-xs leading-relaxed text-secondary/75">
          Te asesoramos en desarrollo web, hosting, bases de datos y soporte integral para tu
          empresa.
        </p>
        <a
          href="/#contact"
          class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl border border-primary bg-primary/20 px-4 py-2.5 text-xs font-bold text-primary transition-[transform,scale,background-color,box-shadow] duration-300 ease-out hover:scale-[1.02] hover:bg-primary/30 hover:shadow-md hover:shadow-primary/20 focus:ring-2 focus:ring-primary focus:outline-none"
        >
          <Icon name="mail" class="h-4 w-4" aria-hidden="true" />
          <span>Ir al formulario de contacto</span>
        </a>
      </div>
    </aside>
  </div>

  <!-- Botón Volver al Blog (Centrado como cierre global de la página) -->
  <nav aria-label="Navegación de retorno" class="flex w-full justify-center px-4 pb-24 md:pb-32">
    <a
      href="/blog"
      class="group inline-flex items-center gap-2.5 rounded-xl border border-white/20 bg-white/5 px-8 py-3 text-sm font-medium text-secondary transition-[transform,scale,border-color,background-color,color] duration-300 ease-out hover:scale-105 hover:border-primary hover:bg-primary/10 hover:text-primary focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:outline-none"
    >
      <span aria-hidden="true" class="transition-transform duration-300 group-hover:-translate-x-1"
        >←</span
      >
      <span>Volver a todas las guías y artículos</span>
    </a>
  </nav>
</Layout>
