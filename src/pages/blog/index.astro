---
import { getCollection } from 'astro:content';
import Layout from 'layouts/Layout.astro';
import BlogCard from 'components/cards/BlogCard.astro';
import Icon from 'components/ui/Icon.astro';
import { titleBlog, subTitleBlog } from 'consts/pagesTitle';

export const prerender = true;

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const blogSeoTitle = 'Blog de Tecnología y Soporte Informático | SV Tech';
const blogSeoDescription =
  'Guías prácticas, tutoriales de soporte informático remoto y novedades tecnológicas de SV Tech para optimizar la productividad y seguridad de tu empresa.';
---

<Layout
  title={blogSeoTitle}
  description={blogSeoDescription}
>
  <div class="relative flex w-full max-w-[1200px] flex-col items-center gap-12 px-4 pt-32 pb-24 md:pt-40 md:pb-32">
    <!-- Header Hero con convención estándar de SV Tech -->
    <header class="reveal flex w-[90%] flex-col items-center justify-center gap-4 text-center md:w-[100%]">
      <h1 class="text-2xl font-bold text-secondary uppercase duration-300 sm:text-4xl md:text-5xl">
        {titleBlog}
      </h1>
      <h2 class="text-sm font-medium text-primary sm:text-lg md:text-3xl">
        {subTitleBlog}
      </h2>
    </header>

    <!-- Buscador en tiempo real -->
    <div class="reveal w-full max-w-xl px-2">
      <div class="group relative flex items-center">
        <span class="pointer-events-none absolute left-4 text-secondary/70 transition-colors duration-300 group-focus-within:text-primary">
          <Icon name="search" class="h-5 w-5" aria-hidden="true" />
        </span>
        <input
          type="search"
          id="blog-search-input"
          placeholder="Buscar por palabra clave, herramienta o etiqueta..."
          aria-label="Buscar guías y artículos"
          class="w-full rounded-2xl border border-white/10 bg-gradient-primary/80 py-3.5 pr-10 pl-12 text-sm text-secondary placeholder:text-secondary/70 backdrop-blur-xl transition-[border-color,box-shadow] duration-300 ease-out focus:border-primary focus:shadow-lg focus:shadow-primary/20 focus:outline-none sm:text-base [&::-webkit-search-cancel-button]:hidden [&::-webkit-search-decoration]:hidden"
        />
        <button
          id="clear-search-btn"
          type="button"
          class="absolute right-3.5 hidden h-6 w-6 cursor-pointer items-center justify-center rounded-full bg-white/10 text-secondary/70 transition hover:bg-white/20 hover:text-white focus:outline-none"
          aria-label="Limpiar búsqueda"
        >
          ✕
        </button>
      </div>
      <p id="search-results-counter" class="mt-2 text-center text-xs font-medium text-secondary/60"></p>
    </div>

    <!-- Apartado de Herramienta Gratuita para la Comunidad -->
    <section
      aria-label="Herramienta web gratuita de la comunidad"
      class="reveal w-full"
    >
      <div
        class="flex flex-col items-start justify-between gap-5 rounded-2xl border border-tertiary/50 bg-gradient-primary/85 p-6 shadow-lg shadow-tertiary/15 backdrop-blur-xl sm:flex-row sm:items-center sm:p-7"
      >
        <div class="flex items-start gap-4 sm:items-center">
          <div
            class="flex size-12 shrink-0 items-center justify-center rounded-xl border border-primary/40 bg-primary/15 text-primary"
          >
            <svg
              class="size-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="5" height="5" x="3" y="3" rx="1" />
              <rect width="5" height="5" x="16" y="3" rx="1" />
              <rect width="5" height="5" x="3" y="16" rx="1" />
              <path d="M21 16h-3a2 2 0 0 0-2 2v3" />
              <path d="M21 21v.01" />
              <path d="M12 7v3a2 2 0 0 1-2 2H7" />
              <path d="M3 12h.01" />
              <path d="M12 3h.01" />
              <path d="M12 16v.01" />
              <path d="M16 12h1" />
              <path d="M21 12v.01" />
              <path d="M12 21v-1" />
            </svg>
          </div>
          <div class="space-y-1">
            <h2 class="text-base font-bold text-secondary uppercase sm:text-lg">
              Generador de Códigos QR Gratis con Logo y Sin Caducidad
            </h2>
            <p class="max-w-2xl text-xs leading-relaxed text-secondary/85 sm:text-sm">
              Utilidad 100% gratuita y sin registro desarrollada por SV Tech para la comunidad. Crea códigos QR estáticos para tu sitio web, WhatsApp, red Wi-Fi o contacto vCard en PNG y SVG vectorial.
            </p>
          </div>
        </div>

        <a
          href="/herramientas/generador-qr"
          class="inline-flex shrink-0 items-center gap-2 rounded-lg border border-primary bg-primary px-5 py-2.5 text-xs font-bold text-gradient-secondary transition duration-300 hover:scale-105 focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:outline-none sm:text-sm"
        >
          <span>Abrir Generador QR</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- Listado de Artículos -->
    <section class="w-full">
      <div
        id="blog-cards-container"
        class="grid w-full grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-2"
      >
        {sortedPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupBlogSearch() {
    const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clear-search-btn') as HTMLButtonElement | null;
    const counter = document.getElementById('search-results-counter') as HTMLParagraphElement | null;
    const cardsContainer = document.getElementById('blog-cards-container') as HTMLDivElement | null;
    const cards = document.querySelectorAll<HTMLElement>('[data-blog-card]');

    if (!searchInput || !cardsContainer || cards.length === 0) return;

    let noResults =
      (cardsContainer.parentElement?.querySelector('#no-search-results') as HTMLDivElement | null) ??
      null;

    function createNoResults(): HTMLDivElement {
      const element = document.createElement('div');
      element.id = 'no-search-results';
      element.className =
        'hidden flex-col items-center justify-center rounded-2xl border border-white/10 bg-gradient-primary/50 p-12 text-center';

      const icon = document.createElement('span');
      icon.className = 'text-3xl';
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = '🔍';

      const heading = document.createElement('p');
      heading.className = 'mt-3 text-lg font-semibold text-secondary';
      heading.textContent = 'No se encontraron artículos';

      const hint = document.createElement('p');
      hint.className = 'mt-1 text-sm text-secondary/70';
      hint.textContent = 'Intenta buscar con otra palabra clave o término.';

      element.append(icon, heading, hint);
      return element;
    }

    function filterCards() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let visibleCount = 0;

      if (clearBtn) {
        if (query.length > 0) {
          clearBtn.classList.remove('hidden');
          clearBtn.classList.add('flex');
        } else {
          clearBtn.classList.add('hidden');
          clearBtn.classList.remove('flex');
        }
      }

      cards.forEach((card) => {
        const searchable = card.getAttribute('data-searchable') || '';
        const matches = query === '' || searchable.includes(query);

        if (matches) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (counter) {
        if (query.length > 0) {
          counter.textContent = `${visibleCount} ${visibleCount === 1 ? 'resultado encontrado' : 'resultados encontrados'}`;
        } else {
          counter.textContent = '';
        }
      }

      if (visibleCount === 0 && query.length > 0) {
        if (!noResults) {
          noResults = createNoResults();
          cardsContainer.parentElement?.append(noResults);
        }
        noResults.classList.remove('hidden');
        noResults.classList.add('flex');
      } else if (noResults) {
        noResults.classList.add('hidden');
        noResults.classList.remove('flex');
      }
    }

    searchInput.addEventListener('input', filterCards);

    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
        filterCards();
      }
    });
  }

  document.addEventListener('astro:page-load', setupBlogSearch);
</script>
