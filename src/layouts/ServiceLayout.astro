---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: string;
}

const { title, description, image, canonicalURL, type } = Astro.props;
---

<Layout
  title={title}
  description={description}
  image={image}
  canonicalURL={canonicalURL}
  type={type}
  showHeader={false}
  showScrollToTop={false}
>
  <slot />
</Layout>

