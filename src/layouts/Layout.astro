---
import { ClientRouter } from 'astro:transitions';
import SpeedInsights from '@vercel/speed-insights/astro';

import 'styles/global.css';
import { fixedTitle } from 'consts/pagesTitle';
import MetaTag from 'components/common/MetaTag.astro';
import FontPreload from 'components/common/FontPreload.astro';
import Analytics from 'components/common/Analytics.astro';
import StructuredData from 'components/common/StructuredData.astro';
import SmokeScreen from 'components/common/SmokeScreen.astro';
import Header from 'components/common/Header.astro';
import ScrollToTop from 'components/common/ScrollToTop.astro';
import Footer from 'components/common/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: string;
  robots?: string;
  showHeader?: boolean;
  showScrollToTop?: boolean;
  showSmokeScreen?: boolean;
}

const {
  title = fixedTitle,
  description,
  image,
  canonicalURL,
  type,
  robots,
  showHeader = true,
  showScrollToTop = true,
  showSmokeScreen = true,
} = Astro.props;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/svtech-icon-touch.png" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

    <!-- preloading web fonts -->
    <FontPreload />

    <!-- Open Graph & Meta Tags -->
    <MetaTag
      title={title}
      description={description}
      image={image}
      canonicalURL={canonicalURL}
      type={type}
      robots={robots}
    />

    <ClientRouter />

    <Analytics />

    <!-- Datos estructurados para mejorar SEO -->
    <StructuredData />
  </head>

  <body>
    {showSmokeScreen && <SmokeScreen />}

    {showHeader && <Header />}

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-primary focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido principal
    </a>

    <main id="main-content" role="main">
      <slot />

      {showScrollToTop && <ScrollToTop />}
    </main>

    <Footer />

    <SpeedInsights />

    <script>
      import { initScrollReveal } from 'lib/managers/scroll-reveal-manager';

      document.addEventListener('astro:page-load', () => {
        initScrollReveal();
      });
    </script>
  </body>
</html>

<style>
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #001217, #00252d);
    background-attachment: fixed;
  }

  main {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
</style>
