---
import { ClientRouter } from 'astro:transitions';
import SpeedInsights from '@vercel/speed-insights/astro';

import 'styles/global.css';
import { fixedTitle } from 'consts/pagesTitle';
import MetaTag from 'components/common/MetaTag.astro';
import Header from 'components/common/Header.astro';
import ScrollToTop from 'components/common/ScrollToTop.astro';
import Footer from 'components/common/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: string;
  showHeader?: boolean;
  showScrollToTop?: boolean;
  showSmokeScreen?: boolean;
}

const {
  title = fixedTitle,
  description,
  image,
  canonicalURL,
  type,
  showHeader = true,
  showScrollToTop = true,
  showSmokeScreen = true,
} = Astro.props;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/svtech-icon-touch.png" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

    <!-- preloading web fonts -->
    <link
      rel="preload"
      href="/fonts/poppins-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link
      rel="preload"
      href="/fonts/poppins-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link
      rel="preload"
      href="/fonts/poppins-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph & Meta Tags -->
    <MetaTag
      title={title}
      description={description}
      image={image}
      canonicalURL={canonicalURL}
      type={type}
    />

    <ClientRouter />

    <!-- Google tag (gtag.js) -->
    <script
      type="text/partytown"
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-NX19ERRPWS"></script>

    <script type="text/partytown" is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-NX19ERRPWS');

      document.addEventListener('astro:page-load', () => {
        if (typeof gtag === 'function') {
          gtag('config', 'G-NX19ERRPWS', {
            page_path: window.location.pathname,
          });
        }
      });
    </script>

    <!-- Datos estructurados para mejorar SEO -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "ProfessionalService",
            "name": "SV Tech",
            "alternateName": "SVTech",
            "@id": "https://www.svtech.cl/#localbusiness",
            "url": "https://www.svtech.cl",
            "telephone": "+56987933282",
            "email": "contacto@svtech.cl",
            "priceRange": "$$",
            "slogan": "Transformando ideas en realidades digitales",
            "description": "Servicios de soporte informático, mantenimiento de equipos y desarrollo web a medida para empresas en Chile.",
            "image": "https://www.svtech.cl/og.png",
            "logo": {
              "@type": "ImageObject",
              "url": "https://www.svtech.cl/favicon.svg"
            },
            "sameAs": [
              "https://twitter.com/svtech_code",
              "https://www.instagram.com/svtech_code/",
              "https://discord.gg/DUhM8uc3HM"
            ],
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Linares",
              "addressRegion": "Maule",
              "addressCountry": "CL"
            },
            "areaServed": {
              "@type": "Country",
              "name": "Chile"
            },
            "availableLanguage": ["Spanish"],
            "openingHoursSpecification": [
              {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": [
                  "Monday",
                  "Tuesday",
                  "Wednesday",
                  "Thursday",
                  "Friday",
                  "Saturday"
                ],
                "opens": "09:00",
                "closes": "14:00"
              },
              {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": [
                  "Monday",
                  "Tuesday",
                  "Wednesday",
                  "Thursday",
                  "Friday",
                  "Saturday"
                ],
                "opens": "15:00",
                "closes": "20:00"
              }
            ],
            "knowsAbout": [
              "Soporte Informático",
              "Desarrollo Web",
              "Consultoría TI",
              "Administración de Hosting",
              "Bases de Datos",
              "Google Apps Script",
              "Google Sheets",
              "Automatización de procesos",
              "React",
              "Astro",
              "PHP",
              "PostgreSQL",
              "TailwindCSS",
              "Administración de servidores y correo corporativo"
            ],
            "hasOfferCatalog": {
              "@type": "OfferCatalog",
              "name": "Servicios de SV Tech",
              "itemListElement": [
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Soporte Informático",
                    "url": "https://www.svtech.cl/services/soporte-informatico"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Desarrollo web",
                    "url": "https://www.svtech.cl/services/desarrollo-web"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Consultoría TI",
                    "url": "https://www.svtech.cl/services/consultoria-ti"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Administración Hosting",
                    "url": "https://www.svtech.cl/services/administracion-hosting"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Base de Datos",
                    "url": "https://www.svtech.cl/services/base-datos"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Soporte Personalizado",
                    "url": "https://www.svtech.cl/services/soporte-personalizado"
                  }
                }
              ]
            }
          },
          {
            "@type": "WebSite",
            "@id": "https://www.svtech.cl/#website",
            "url": "https://www.svtech.cl",
            "name": "SV Tech",
            "inLanguage": "es-CL",
            "publisher": {
              "@id": "https://www.svtech.cl/#localbusiness"
            }
          }
        ]
      }
    </script>
  </head>

  <body>
    {
      showSmokeScreen && (
        <div
          id="smoke-screen"
          aria-hidden="true"
          class="animate-fade-out pointer-events-none fixed inset-0 z-50 bg-gradient-to-br from-[#00252d] to-[#0096b8]"
        />
      )
    }

    {showHeader && <Header />}

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-primary focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido principal
    </a>

    <main id="main-content" role="main">
      <slot />

      {showScrollToTop && <ScrollToTop />}
    </main>

    <Footer />

    <SpeedInsights />

    <script>
      import { initScrollReveal } from 'lib/managers/scroll-reveal-manager';

      document.addEventListener('astro:page-load', () => {
        initScrollReveal();
      });
    </script>
  </body>
</html>

<style>
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #001217, #00252d);
    background-attachment: fixed;
  }

  main {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @keyframes fade-out {
    0% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  .animate-fade-out {
    animation: fade-out 0.8s ease-in-out forwards;
    will-change: opacity;
  }
</style>
